name = "interior-quote-ingest"
main = "worker.mjs"
compatibility_date = "2026-09-10"

[[d1_databases]]
binding = "QUOTE_DB"
database_name = "interior-quote-private"
database_id = "REPLACE_ME"

[vars]
ALLOWED_ORIGIN = "https://REPLACE_WITH_APPROVED_DOMAIN"
ADMIN_API_ENABLED = "false"
ADMIN_ORIGIN = "https://REPLACE_WITH_PRIVATE_ADMIN_ORIGIN"

# TURNSTILE_SECRET, ADMIN_API_TOKEN은 이 파일에 쓰지 않는다.
# wrangler secret put TURNSTILE_SECRET
# wrangler secret put ADMIN_API_TOKEN
# 관리자 콘솔을 실제 보호된 Origin에 배포한 뒤에만 ADMIN_API_ENABLED = "true"로 바꾼다.
# quote-admin/은 공개 production 정적 빌드에 포함하지 않는다.
# 이 파일은 배포 예시이며 v6 검수 브랜치에서는 실제 배포하지 않는다.
