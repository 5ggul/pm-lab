{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://5ggul.github.io/pm-lab/interior-cost-preview/data/quote-sample-schema.json",
  "title": "Anonymized interior quote sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "quote_month",
    "region_level1",
    "supply_pyeong",
    "building_type",
    "scope",
    "bathroom_count",
    "window_scope",
    "vat_state",
    "waste_state",
    "total_amount_manwon"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,40}$"
    },
    "quote_month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "region_level1": {
      "enum": [
        "서울",
        "부산",
        "대구",
        "인천",
        "광주",
        "대전",
        "울산",
        "세종",
        "경기",
        "강원",
        "충북",
        "충남",
        "전북",
        "전남",
        "경북",
        "경남",
        "제주"
      ]
    },
    "supply_pyeong": {
      "type": "number",
      "minimum": 5,
      "maximum": 100
    },
    "exclusive_pyeong": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "building_type": {
      "enum": [
        "아파트",
        "빌라",
        "주택"
      ]
    },
    "scope": {
      "enum": [
        "올수리",
        "부분"
      ]
    },
    "bathroom_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "window_scope": {
      "enum": [
        "전체",
        "부분",
        "제외",
        "미기재"
      ]
    },
    "vat_state": {
      "enum": [
        "포함",
        "별도",
        "미기재"
      ]
    },
    "waste_state": {
      "enum": [
        "포함",
        "별도",
        "미기재"
      ]
    },
    "total_amount_manwon": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100000
    },
    "demolition_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "waste_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "waterproof_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "bathroom_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "kitchen_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "wallpaper_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "flooring_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "carpentry_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "electrical_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "window_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "management_manwon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    }
  }
}