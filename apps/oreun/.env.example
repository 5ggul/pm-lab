# Preview-only switch. Synthetic historical data is NEVER enabled by default.
R1_PREVIEW_FIXTURES=0
R1_PREVIEW_NO_INDEX=1

# Public origin. Index release remains locked unless this is a non-localhost HTTPS URL.
NEXT_PUBLIC_SITE_URL=

# Dedicated R1 Supabase only. Do not point these at an unrelated project.
SUPABASE_URL=
# Preferred server-only key for 2026+ Supabase projects.
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Never expose either server key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public browser/Auth client used by Sprint 02. Publishable key only; never use a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Protects POST /api/internal/collector/run. CRON_SECRET is also accepted.
R1_COLLECTOR_TRIGGER_SECRET=
CRON_SECRET=

# Sprint 02 Account/Q&A uses Supabase Auth + RLS. No extra client secret is required.
# Email confirmation redirect should be configured to the final HTTPS domain before launch.
