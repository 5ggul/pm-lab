# Preview-only switch. Synthetic historical data is NEVER enabled by default.
R1_PREVIEW_FIXTURES=0
R1_PREVIEW_NO_INDEX=1

# Final release latch. Keep 0 until the user explicitly approves index release.
# Indexing releases only when:
# R1_PREVIEW_NO_INDEX=0 + R1_INDEX_RELEASE_CONFIRM=1 + valid public HTTPS origin.
R1_INDEX_RELEASE_CONFIRM=0

# Set to 1 only after the hosted Supabase Before User Created hook is enabled
# and real QA proves: Google signup allowed, new email signup rejected,
# existing legacy email login still works.
R1_GOOGLE_ONLY_SIGNUP_HOOK_CONFIRM=0
R1_GOOGLE_E2E_CONFIRM=0
R1_COMMUNITY_E2E_CONFIRM=0

# Public origin. Private/local/reserved hosts do not qualify for index release.
NEXT_PUBLIC_SITE_URL=

# Dedicated R1 Supabase only. Do not point these at an unrelated project.
SUPABASE_URL=
# Preferred server-only key for 2026+ Supabase projects.
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Never expose either server key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public browser/Auth client used by Sprint 02. Publishable key only; never use a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional HTTPS read-only fallback for reviewed provider outages only.
# Do not configure this to bypass Roblox regional availability/content restrictions.
# The collector validates source, universe ID, root place, playing and freshness.
R1_ROBLOX_RELAY_URL=

# Protects POST /api/internal/collector/run. CRON_SECRET is also accepted.
R1_COLLECTOR_TRIGGER_SECRET=
CRON_SECRET=

# Sprint 02 Account/Q&A uses Supabase Auth + RLS. No extra client secret is required.
# Email confirmation redirect should be configured to the final HTTPS domain before launch.

# Sprint 05 Roblox Community Analytics. Aggregate-only and OFF by default.
# These are SERVER-ONLY. Never add NEXT_PUBLIC_ to the API key or trigger secret.
R1_ROBLOX_COMMUNITY_ANALYTICS=0
ROBLOX_OPEN_CLOUD_API_KEY=
R1_COMMUNITY_ANALYTICS_TRIGGER_SECRET=

# Bounded observation limits. Values above the hard caps are clamped.
R1_COMMUNITY_MAX_CATEGORIES=5
R1_COMMUNITY_MAX_POSTS=20
R1_COMMUNITY_MAX_TARGETS=5
R1_COMMUNITY_MIN_INTERVAL_MINUTES=60

# Actual owner-monitored private inbox/form. Keep unset until verified; no invented address.
R1_PRIVATE_CONTACT_VERIFIED=0
R1_PRIVATE_CONTACT_EMAIL=
R1_PRIVATE_CONTACT_URL=
